{
  "name": "ethonline-agentguard",
  "version": "1.0.0",
  "private": false,
  "description": "Policy-gated agent commerce with live Graph decisions, Privy-controlled wallets and verified USDC settlement on Arc.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev",
    "security:audit:full": "npm audit --audit-level=high",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network monadTestnet",
    "deploy:parallel:testnet": "hardhat run scripts/deploy-parallel.ts --network monadTestnet",
    "fund:seller": "hardhat run scripts/fund-seller.ts --network monadTestnet",
    "fund:verifier": "hardhat run scripts/fund-verifier.ts --network monadTestnet",
    "fund:metamask-agent-wallet": "hardhat run scripts/fund-metamask-agent-wallet.ts --network monadTestnet",
    "task:testnet": "hardhat run scripts/run-testnet-task.ts --network monadTestnet",
    "tasks:failure-paths": "hardhat run scripts/run-failure-tasks.ts --network monadTestnet",
    "task:recover-frozen": "hardhat run scripts/recover-frozen-task.ts --network monadTestnet",
    "benchmark": "hardhat run scripts/benchmark.ts",
    "benchmark:testnet": "hardhat run scripts/benchmark-testnet.ts --network monadTestnet",
    "benchmark:e2e:testnet": "hardhat run scripts/benchmark-e2e-testnet.ts --network monadTestnet",
    "benchmark:e2e:verify": "node --import tsx scripts/verify-e2e-benchmark.ts",
    "benchmark:concurrent:testnet": "hardhat run scripts/benchmark-concurrent-testnet.ts --network monadTestnet",
    "benchmark:concurrent:verify": "node --import tsx scripts/verify-concurrent-benchmark.ts",
    "benchmark:parallel:testnet": "hardhat run scripts/benchmark-parallel-testnet.ts --network monadTestnet",
    "benchmark:parallel:verify": "node --import tsx scripts/verify-parallel-benchmark.ts",
    "benchmark:parallel:rebalance": "hardhat run scripts/rebalance-parallel-actors.ts --network monadTestnet",
    "benchmark:parallel:complete": "hardhat run scripts/complete-parallel-benchmark.ts --network monadTestnet",
    "benchmark:refund": "hardhat run scripts/refund-benchmark.ts --network monadTestnet",
    "demo": "tsx scripts/demo.ts",
    "agent:flow": "node --import tsx scripts/agent-to-agent.ts",
    "yieldscout:report": "node --import tsx scripts/yieldscout-report.ts",
    "chainsentinel:report": "hardhat run scripts/chainsentinel-report.ts --network monadTestnet",
    "sponsor:metamask": "node --import tsx scripts/metamask-agent-wallet-demo.ts",
    "sponsor:metamask:rpc-bridge": "node --import tsx scripts/metamask-rpc-bridge.ts",
    "sponsor:metamask:complete": "hardhat run scripts/complete-metamask-agent-wallet-task.ts --network monadTestnet",
    "pilot:complete": "hardhat run scripts/complete-pilot-task.ts --network monadTestnet",
    "judge:demo": "node --import tsx scripts/judge-demo.ts",
    "evidence:verify": "node --import tsx scripts/verify-evidence.ts",
    "judge:manifest": "node --import tsx scripts/verify-judge-manifest.ts",
    "ethonline:graph:check": "node --env-file-if-exists=.env --import tsx scripts/ethonline-graph-check.ts",
    "ethonline:arc:wallets": "node --import tsx scripts/create-arc-wallets.ts",
    "ethonline:arc:deploy": "node --env-file-if-exists=.env ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/deploy-arc-escrow.ts --network arcTestnet",
    "ethonline:arc:bootstrap-task": "node --env-file-if-exists=.env ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/run-arc-bootstrap-task.ts --network arcTestnet",
    "ethonline:arc:graph-task": "node --env-file-if-exists=.env ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/run-arc-graph-driven-task.ts --network arcTestnet",
    "ethonline:arc:verification-input": "node --import tsx scripts/export-arc-verification-input.ts",
    "ethonline:subgraph:abi": "node --import tsx scripts/sync-subgraph-abi.ts",
    "ethonline:subgraph:codegen": "npm --prefix subgraph run codegen",
    "ethonline:subgraph:build": "npm --prefix subgraph run build",
    "ethonline:subgraph:check": "npm run ethonline:subgraph:abi && npm --prefix subgraph ci --no-audit --no-fund && npm run ethonline:subgraph:codegen && npm run ethonline:subgraph:build",
    "ethonline:privy:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.privy --import tsx scripts/ethonline-privy-check.ts",
    "ethonline:privy:keygen": "node --import tsx scripts/create-privy-authorization-key.ts",
    "ethonline:privy:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.privy --import tsx scripts/setup-privy-arc-wallet.ts",
    "ethonline:privy:arc-task": "node --env-file-if-exists=.env --env-file-if-exists=.env.privy --import tsx scripts/run-privy-arc-task.ts",
    "ethonline:privy:failure-tasks": "node --env-file-if-exists=.env --env-file-if-exists=.env.privy --import tsx scripts/run-privy-arc-failure-tasks.ts",
    "ethonline:failure:evidence:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-live-failure-evidence.ts",
    "ethonline:privy:evidence:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-privy-arc-evidence.ts",
    "ethonline:demo": "tsx scripts/ethonline-demo.ts",
    "ethonline:receipt:verify": "node --import tsx scripts/ethonline-receipt-check.ts",
    "ethonline:manifest:verify": "node --import tsx scripts/verify-ethonline-manifest.ts",
    "ethonline:submission:check": "node --import tsx scripts/ethonline-submission-check.ts",
    "ethonline:preflight": "node --env-file-if-exists=.env --import tsx scripts/ethonline-preflight.ts",
    "ethonline:check": "npm run build && npm run typecheck && npm test && npm run ethonline:subgraph:check && npm run ethonline:demo && npm run ethonline:receipt:verify && npm run ethonline:graph:check && npm run ethonline:privy:check && npm run ethonline:privy:evidence:verify && npm run ethonline:failure:evidence:verify && npm run ethonline:manifest:verify && npm run ethonline:submission:check",
    "judge:check": "npm run build && npm run typecheck && npm test && npm run evidence:verify && npm run judge:manifest && npm run benchmark:e2e:verify && npm run benchmark:concurrent:verify && npm run benchmark:parallel:verify && npm run judge:demo"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "hardhat": "^3.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@privy-io/node": "^0.34.0",
    "viem": "^2.44.2"
  }
}
